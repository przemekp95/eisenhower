# Required by the local Docker Compose stack. Copy this file to .env and use
# unique values; do not commit the resulting .env file.
EISENHOWER_API_TOKEN=replace-with-a-random-token-at-least-32-characters
EISENHOWER_ADMIN_TOKEN=replace-with-a-different-random-token-at-least-32-characters
MINIO_ROOT_USER=replace-with-a-unique-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
GRAFANA_ADMIN_USER=replace-with-a-unique-grafana-admin-user
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
AUTH_MODE=static
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# RAG_ENABLED is legacy compatibility. Prefer the phase-specific flags below.
RAG_ENABLED=false
RAG_RETRIEVAL_ENABLED=false
RAG_GENERATION_ENABLED=false
RAG_RESPONSE_ENABLED=false
RAG_ALLOWED_TENANTS=
QDRANT_API_KEY=
# Private OpenAI-compatible inference. Leave all RAG flags false when unused.
INFERENCE_BASE_URL=http://inference:8000/v1
INFERENCE_ALLOWED_HOSTS=
INFERENCE_API_KEY=
INFERENCE_MODEL=
INFERENCE_CONNECT_TIMEOUT_SECONDS=2
INFERENCE_READ_TIMEOUT_SECONDS=15
INFERENCE_WRITE_TIMEOUT_SECONDS=5
INFERENCE_POOL_TIMEOUT_SECONDS=1
INFERENCE_CIRCUIT_FAILURE_THRESHOLD=3
INFERENCE_CIRCUIT_RESET_SECONDS=30
EISENHOWER_INTERNAL_API_TOKEN=
EISENHOWER_WEBHOOK_SECRET=
INTERNAL_ALLOWED_TENANTS=
N8N_ENCRYPTION_KEY=
