# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6335
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false

# Collection settings
QDRANT_COLLECTION=eisenhower_task_embeddings
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# Migration Script Configuration
MIGRATION_MAX_RETRIES=5
MIGRATION_RETRY_DELAY=2
MIGRATION_BATCH_SIZE=50
MIGRATION_PARALLEL_WORKERS=2

# Training data path
TRAINING_DATA_PATH=data/training.json

# MinIO Object Storage (opcjonalne - jeżeli nie ustawione używa lokalnego FS)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=eisenhower-admin
MINIO_SECRET_KEY=StrongPassword123!
MINIO_BUCKET=eisenhower
MINIO_SECURE=false
