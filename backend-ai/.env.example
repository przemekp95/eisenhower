APP_ENV=development
AUTH_MODE=static
EISENHOWER_API_TOKEN=replace-with-a-long-random-user-token
EISENHOWER_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
LOCAL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42

# Private Qdrant retrieval configuration. RAG_ENABLED is legacy; new environments
# should use the three phase-specific flags.
RAG_ENABLED=false
RAG_RETRIEVAL_ENABLED=false
RAG_RETRIEVAL_STRATEGY=hybrid-bge-v1
RAG_GENERATION_ENABLED=false
RAG_RESPONSE_ENABLED=false
RAG_RESPONSE_PROMOTION_POINTER_PATH=
RAG_RESPONSE_CANDIDATE_ID=
RAG_ALLOWED_TENANTS=
RAG_RESPONSE_ALLOWED_USERS=
CHUNKING_VERSION=chars-1200-overlap-160-v1
INTERNAL_ALLOWED_TENANTS=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=eisenhower-knowledge-active
RERANKER_BASE_URL=http://reranker:8000
RERANKER_ALLOWED_HOSTS=reranker
RERANKER_API_KEY=
MONGODB_URI=mongodb://mongodb:27017/eisenhower
MONGODB_DATABASE=eisenhower
CANONICAL_DOCUMENTS_COLLECTION=rag_documents
CORPUS_REPOSITORY_ROOT=/corpus
CORPUS_MANIFEST_PATH=/corpus/docs/ai-rebuild/corpus-manifest-v1.json
CORPUS_OWNER_ID=eisenhower-owner
CORPUS_ALLOWED_PROJECTS=eisenhower
MEMORY_WRITE_ENABLED=false
MEMORY_RETRIEVAL_ENABLED=false
MEMORY_RESPONSE_ENABLED=false
MEMORY_POLICY_PATH=/corpus/docs/ai-rebuild/memory-policy-v1.json
EMBEDDING_VERSION=minilm-v1
# Vendor-neutral private OpenAI-compatible inference endpoint. `VLLM_*` names
# remain accepted only as legacy compatibility input.
INFERENCE_BASE_URL=http://inference:8000/v1
INFERENCE_ALLOWED_HOSTS=
INFERENCE_MODEL=
INFERENCE_API_KEY=
INFERENCE_CONNECT_TIMEOUT_SECONDS=2
INFERENCE_READ_TIMEOUT_SECONDS=15
INFERENCE_WRITE_TIMEOUT_SECONDS=5
INFERENCE_POOL_TIMEOUT_SECONDS=1
INFERENCE_CIRCUIT_FAILURE_THRESHOLD=3
INFERENCE_CIRCUIT_RESET_SECONDS=30
PROMPT_ARTIFACT_DIR=prompts
PROMPT_ID=eisenhower-classifier
PROMPT_VERSION=1.1.0
RETRIEVAL_VERSION=retrieval-v1
INDEX_VERSION=index-v1

# Migration Script Configuration
MIGRATION_MAX_RETRIES=5
MIGRATION_RETRY_DELAY=2
MIGRATION_BATCH_SIZE=50
MIGRATION_PARALLEL_WORKERS=2

# Training data path
TRAINING_DATA_PATH=data/training.json

# Internal n8n/job endpoints. Keep private and use independent secrets.
EISENHOWER_INTERNAL_API_TOKEN=
EISENHOWER_WEBHOOK_SECRET=
JOBS_DATABASE_PATH=data/jobs.sqlite3

# Optional MinIO object storage; local filesystem is used when unset.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-unique-minio-admin-user
MINIO_SECRET_KEY=replace-with-long-random-minio-secret
MINIO_BUCKET=eisenhower
MINIO_SECURE=false
