# Qdrant Vector Database Configuration
APP_ENV=development
EISENHOWER_API_TOKEN=replace-with-a-local-runtime-token
EISENHOWER_ADMIN_TOKEN=replace-with-a-different-local-admin-token

QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6335
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false

# Collection settings
QDRANT_COLLECTION=eisenhower_task_embeddings
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# Migration Script Configuration
MIGRATION_MAX_RETRIES=5
MIGRATION_RETRY_DELAY=2
MIGRATION_BATCH_SIZE=50
MIGRATION_PARALLEL_WORKERS=2

# Training data path
TRAINING_DATA_PATH=data/training.json

# MinIO object storage (optional; local filesystem is used when unset)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-unique-minio-admin-user
MINIO_SECRET_KEY=replace-with-long-random-minio-secret
MINIO_BUCKET=eisenhower
MINIO_SECURE=false
