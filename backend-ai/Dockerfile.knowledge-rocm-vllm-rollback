FROM vllm/vllm-openai-rocm@sha256:3be0d8f3ec3ebcc99203e08d895392a8d749ed8a132f41574a8018cdaf525a22

ARG RELEASE_SHA
LABEL org.opencontainers.image.revision=$RELEASE_SHA \
      eisenhower.runtime.role=knowledge-rocm-vllm-rollback

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=on \
    PIP_DISABLE_PIP_VERSION_CHECK=on HF_HOME=/home/app/.cache/huggingface \
    TOKENIZERS_PARALLELISM=false
WORKDIR /app
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends curl libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade setuptools==80.9.0 wheel==0.46.3 \
    && python -m pip uninstall -y PyGObject \
    && useradd --uid 1000 --create-home --shell /bin/bash app \
    && mkdir -p /app/data /app/logs /home/app/.cache/huggingface \
    && chown -R app:app /app /home/app
COPY requirements-boundary.txt requirements-knowledge-rocm.txt ./
RUN python -m pip install --no-cache-dir -r requirements-knowledge-rocm.txt \
    && python -m pip check
COPY --chown=app:app . .
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"
EXPOSE 8000
ENTRYPOINT []
CMD ["python", "-m", "uvicorn", "app.knowledge_runtime:from_environment", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
