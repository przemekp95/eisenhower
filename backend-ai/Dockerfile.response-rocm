FROM cgr.dev/chainguard/python@sha256:14acabef9a759e7d07bf647afec92bc28cbe0f89c978fe426411c85035121c14 AS dependencies

USER root
COPY requirements-response-rocm.txt /tmp/requirements-response-rocm.txt
RUN --mount=type=cache,target=/root/.cache/pip mkdir -p /opt/python \
    && python -m pip install --target=/opt/python \
      --requirement /tmp/requirements-response-rocm.txt \
    && PYTHONPATH=/opt/python python -m pip check

FROM cgr.dev/chainguard/python@sha256:14acabef9a759e7d07bf647afec92bc28cbe0f89c978fe426411c85035121c14 AS response

ARG RELEASE_SHA
LABEL org.opencontainers.image.revision=$RELEASE_SHA \
      eisenhower.runtime.role=response-transformers-rocm \
      org.opencontainers.image.base.digest=sha256:14acabef9a759e7d07bf647afec92bc28cbe0f89c978fe426411c85035121c14

USER root
RUN apk add --no-cache libatomic
COPY --from=dependencies /opt/python /opt/python
COPY app/__init__.py /app/app/__init__.py
COPY app/response_runtime.py /app/app/response_runtime.py

ENV PYTHONPATH=/app:/opt/python \
    LD_LIBRARY_PATH=/opt/python/torch/lib \
    HF_HOME=/models/huggingface \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
USER 65532:65532

ENTRYPOINT ["python", "-m", "app.response_runtime"]
