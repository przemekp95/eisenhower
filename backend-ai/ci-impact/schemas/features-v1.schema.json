{
  "$id": "https://eisenhower.invalid/schemas/features-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "dependency_impacts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependency Impacts",
      "type": "array"
    },
    "schema_version": {
      "const": "ci-impact-features-v1",
      "default": "ci-impact-features-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "unknown_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unknown Paths",
      "type": "array"
    },
    "values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Values",
      "type": "object"
    }
  },
  "required": [
    "values",
    "checksum"
  ],
  "title": "FeatureVector",
  "type": "object"
}
