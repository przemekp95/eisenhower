{
  "$defs": {
    "ChangeFile": {
      "additionalProperties": false,
      "properties": {
        "additions": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Additions",
          "type": "integer"
        },
        "binary": {
          "default": false,
          "title": "Binary",
          "type": "boolean"
        },
        "deletions": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Deletions",
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "previous_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Path"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "status"
      ],
      "title": "ChangeFile",
      "type": "object"
    },
    "ChangeSet": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ChangeFile"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "head_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "schema_version": {
          "const": "ci-impact-change-set-v1",
          "default": "ci-impact-change-set-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "base_sha",
        "head_sha",
        "files"
      ],
      "title": "ChangeSet",
      "type": "object"
    },
    "JobLabel": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "provenance": {
          "enum": [
            "manual_review",
            "manual_adjudication",
            "manual_review_required"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "value": {
          "enum": [
            "required",
            "safe_to_skip",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "JobLabel",
      "type": "object"
    },
    "JobObservation": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "conclusion": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "neutral",
            "unknown"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "name",
        "conclusion"
      ],
      "title": "JobObservation",
      "type": "object"
    }
  },
  "$id": "https://eisenhower.invalid/schemas/history-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "$ref": "#/$defs/ChangeSet"
    },
    "job_results": {
      "items": {
        "$ref": "#/$defs/JobObservation"
      },
      "title": "Job Results",
      "type": "array"
    },
    "labels": {
      "additionalProperties": {
        "$ref": "#/$defs/JobLabel"
      },
      "title": "Labels",
      "type": "object"
    },
    "merged_at": {
      "format": "date-time",
      "title": "Merged At",
      "type": "string"
    },
    "pull_request_number": {
      "minimum": 1,
      "title": "Pull Request Number",
      "type": "integer"
    },
    "schema_version": {
      "const": "ci-impact-history-record-v1",
      "default": "ci-impact-history-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_sha": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Sha"
    }
  },
  "required": [
    "pull_request_number",
    "merged_at",
    "changes",
    "job_results",
    "labels"
  ],
  "title": "HistoryRecord",
  "type": "object"
}
