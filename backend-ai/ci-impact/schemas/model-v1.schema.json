{
  "$id": "https://eisenhower.invalid/schemas/model-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Independent binary heads for CI jobs; not related to the task-quadrant classifier.",
  "properties": {
    "biases": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Biases",
      "type": "object"
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "feature_names": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Feature Names",
      "type": "array"
    },
    "job_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Job Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "ci-impact-model-v1",
      "default": "ci-impact-model-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "training_dataset_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Dataset Sha256",
      "type": "string"
    },
    "training_seed": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Training Seed",
      "type": "integer"
    },
    "weights": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "title": "Weights",
      "type": "object"
    }
  },
  "required": [
    "job_ids",
    "feature_names",
    "weights",
    "biases",
    "training_dataset_sha256",
    "training_seed",
    "checksum"
  ],
  "title": "MultilabelLogisticModel",
  "type": "object"
}
