{
  "name": "backend-node",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "migrate:tasks": "npm run build && node dist/taskMigrationCli.js",
    "prebuild": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "dev:e2e": "tsx scripts/e2e-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "npm run prisma:generate",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:bdd": "tsc -p tsconfig.bdd.json && NODE_ENV=test node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand"
  },
  "dependencies": {
    "@eisenhower/api-client": "file:../packages/api-client",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.3",
    "ioredis": "5.8.2",
    "jose": "^6.2.12",
    "mongoose": "^9.9.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "8.18.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fastify": "5.12.3",
    "mysql2": "3.24.3",
    "qs": "6.16.0"
  }
}
