{
  "name": "backend-node",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "migrate:tasks": "npm run build && node dist/taskMigrationCli.js",
    "prebuild": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "dev:e2e": "tsx scripts/e2e-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "npm run prisma:generate",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:bdd": "tsc -p tsconfig.bdd.json && NODE_ENV=test node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand"
  },
  "dependencies": {
    "@eisenhower/api-client": "file:../packages/api-client",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "mongoose": "^9.9.2",
    "pg": "8.23.0",
    "rate-limit-redis": "6.0.1",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "8.18.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "mysql2": "3.24.3",
    "deepmerge-ts": "8.0.2"
  }
}
