# Build and publish these application images for one exact source SHA first.
API_IMAGE=przemekp95/eisenhower-api:0000000000000000000000000000000000000000
AI_IMAGE=przemekp95/eisenhower-ai:0000000000000000000000000000000000000000
RELEASE_SHA=0000000000000000000000000000000000000000

# Public images have pinned tag defaults in compose.yaml. Override with a
# registry digest after qualification, for example image@sha256:<digest>.
MONGODB_IMAGE=mongo:7.0.24-jammy
QDRANT_IMAGE=qdrant/qdrant:v1.12.0
N8N_IMAGE=n8nio/n8n:2.4.6
CALENDAR_GATEWAY_IMAGE=nginx:1.27.5-alpine
VOLUME_INIT_IMAGE=alpine:3.20
AMD_INFERENCE_IMAGE=vllm/vllm-openai-rocm:v0.20.0

# Supply operational secrets outside version control.
EISENHOWER_API_TOKEN=
EISENHOWER_ADMIN_TOKEN=
EISENHOWER_INTERNAL_API_TOKEN=
N8N_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
CALENDAR_INTERNAL_HMAC_KEY=
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_ENCRYPTION_KEY=
INFERENCE_API_KEY=
INFERENCE_MODEL=

# An owner-approved production evaluation artifact (absolute host path) and its
# SHA-256 digest.
AI_EVALUATION_FILE=
LOCAL_MODEL_APPROVED_EVALUATION_SHA256=

# Same-host defaults use Compose DNS and loopback-bound host ports.
MONGODB_URI=mongodb://mongodb:27017/eisenhower?replicaSet=rs0
AI_SERVICE_URL=http://ai-service:8000
QDRANT_URL=http://qdrant:6333
EISENHOWER_INTERNAL_API_URL=http://api-service:3001
EISENHOWER_NODE_INTERNAL_API_URL=http://api-service:3001
GOOGLE_CALENDAR_OAUTH_CALLBACK_URL=https://example.invalid/eisenhower/google-calendar/oauth/callback
GOOGLE_CALENDAR_OAUTH_RETURN_ORIGIN=http://127.0.0.1
GOOGLE_CALENDAR_WATCH_CALLBACK_URLS=https://example.invalid/eisenhower/google-calendar/webhook
GOOGLE_CALENDAR_WEBHOOK_URL=https://example.invalid/eisenhower/google-calendar/webhook
CALENDAR_GATEWAY_N8N_UPSTREAM=n8n:5678
CALENDAR_GATEWAY_API_UPSTREAM=api-service:3001
INFERENCE_BASE_URL=http://inference:8000/v1
INFERENCE_ALLOWED_HOSTS=inference

# For a split host, replace only the relevant URL and bind that destination
# service to its real private VPN/LAN address. Never use 0.0.0.0 here.
NODE_BIND_ADDRESS=127.0.0.1
MONGODB_BIND_ADDRESS=127.0.0.1
AI_BIND_ADDRESS=127.0.0.1
QDRANT_BIND_ADDRESS=127.0.0.1
N8N_BIND_ADDRESS=127.0.0.1
CALENDAR_GATEWAY_BIND_PORT=8787
INFERENCE_BIND_ADDRESS=127.0.0.1
