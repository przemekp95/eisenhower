{
  "realm": "eisenhower-e2e",
  "displayName": "Eisenhower synthetic E2E only",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "eisenhower-e2e-claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id", "claim.name": "tenant_id",
            "jsonType.label": "String", "multivalued": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "project-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "project_ids", "claim.name": "project_ids",
            "jsonType.label": "String", "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles", "jsonType.label": "String",
            "multivalued": "true", "usermodel.realmRoleMapping.rolePrefix": "",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "api-target",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "eisenhower-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mcp:tools",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "mcp-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${OIDC_MCP_RESOURCE_URL}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "mcp-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "eisenhower-e2e-mcp-exchange",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "tasks:read", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "tasks:write", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "calendar:read", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "calendar:write", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "knowledge:read", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "ai:analyze", "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "eisenhower-api",
      "name": "Synthetic API resource only",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": []
    },
    {
      "clientId": "eisenhower-e2e",
      "name": "Synthetic test harness only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "eisenhower-e2e-claims", "api-target", "tasks:read", "tasks:write",
        "calendar:read", "calendar:write", "knowledge:read", "ai:analyze"
      ]
    },
    {
      "clientId": "eisenhower-e2e-mcp",
      "name": "Synthetic MCP subject-token client only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "eisenhower-e2e-claims", "mcp:tools", "tasks:read", "tasks:write",
        "calendar:read", "calendar:write", "knowledge:read", "ai:analyze"
      ]
    },
    {
      "clientId": "eisenhower-e2e-mcp-exchange",
      "name": "Synthetic MCP token exchange only",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${EISENHOWER_MCP_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "defaultClientScopes": [
        "eisenhower-e2e-claims", "api-target", "tasks:read", "tasks:write",
        "calendar:read", "calendar:write", "knowledge:read", "ai:analyze"
      ]
    }
  ],
  "roles": {
    "realm": [{ "name": "user" }]
  },
  "users": [
    {
      "id": "10000000-0000-4000-8000-00000000000a",
      "username": "e2e-user-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "User A",
      "email": "e2e-user-a@example.invalid",
      "attributes": { "tenant_id": ["local-e2e"], "project_ids": ["project-a"] },
      "realmRoles": ["user"],
      "credentials": [
        { "type": "password", "value": "${EISENHOWER_E2E_USER_A_PASSWORD}", "temporary": false }
      ]
    },
    {
      "id": "10000000-0000-4000-8000-00000000000b",
      "username": "e2e-user-b",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "User B",
      "email": "e2e-user-b@example.invalid",
      "attributes": { "tenant_id": ["local-e2e"], "project_ids": ["project-b"] },
      "realmRoles": ["user"],
      "credentials": [
        { "type": "password", "value": "${EISENHOWER_E2E_USER_B_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
