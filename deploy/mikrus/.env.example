EISENHOWER_API_TOKEN=replace-with-at-least-32-random-characters
# deploy/mikrus/docker-compose.yml fixes AUTH_MODE=static for the existing
# single-tenant installation. This token is shared by that installation's users.
# OIDC and multi-user production require a different, explicitly configured topology.
EISENHOWER_ADMIN_TOKEN=replace-with-a-different-value-of-at-least-32-random-characters
# Supplied by the release workflow; do not pin this to latest.
IMAGE_TAG=git-commit-sha-is-supplied-by-ci
AUDIT_HMAC_KEY=replace-with-a-separate-random-secret-at-least-32-characters
WEB_PORT=8080
VITE_API_URL=/api
VITE_AI_API_URL=/ai
CORS_ALLOW_ORIGINS=https://your-public-frontend.example
LOCAL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
