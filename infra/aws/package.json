{
  "name": "@eisenhower/aws-infrastructure",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebootstrap:plan": "npm run build && cdk bootstrap --show-template > dist/bootstrap-template.base.yaml && node dist/bin/bootstrap-template.js dist/bootstrap-template.base.yaml dist/bootstrap-template.yaml",
    "bootstrap:plan": "node dist/bin/bootstrap-plan.js",
    "presynth": "npm run build",
    "synth": "cdk synth",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "source-map-support": "0.5.21",
    "yaml": "1.10.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "aws-cdk": "2.1140.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "typescript": "5.7.3"
  }
}
