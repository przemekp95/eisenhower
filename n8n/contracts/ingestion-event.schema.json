{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eisenhower.example/schemas/rag-ingestion-event-v1.json",
  "title": "Eisenhower asynchronous RAG ingestion event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "operation",
    "tenant_id",
    "project_id",
    "source_version",
    "content_checksum",
    "embedding_version",
    "chunking_version"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "event_id": {"type": "string", "format": "uuid"},
    "operation": {
      "enum": ["upsert", "tombstone", "reindex_project", "start_rag_evaluation"]
    },
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "embedding_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "chunking_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "documents": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "source_type", "title", "content", "acl"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_type": {"enum": ["task", "project", "note", "runbook", "calendar_event"]},
          "title": {"type": "string", "maxLength": 1000},
          "content": {"type": "string", "maxLength": 1000000},
          "source_uri": {"type": "string", "maxLength": 2048},
          "updated_at": {"type": "string", "format": "date-time"},
          "acl": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner_id"],
            "properties": {
              "owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "reader_ids": {
                "type": "array",
                "maxItems": 1000,
                "items": {"type": "string", "minLength": 1, "maxLength": 128},
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "document_ids": {
      "type": "array",
      "maxItems": 5000,
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "upsert"}}},
      "then": {"required": ["documents"]}
    },
    {
      "if": {"properties": {"operation": {"const": "tombstone"}}},
      "then": {"required": ["document_ids"]}
    },
    {
      "if": {"properties": {"operation": {"const": "start_rag_evaluation"}}},
      "then": {"required": ["dataset_version"]}
    }
  ]
}
